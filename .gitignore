/target
*.log

# Editor
.zed
.vscode

# Local .NET CLI state
/.dotnet/

# Secrets
.env

# Generated npm release artifacts
/packaging/npm/cli-*/
/packaging/npm/xcrs-*/

# Generated Python release artifacts
/packaging/pypi/*/dist/
/packaging/pypi/*/.venv/
/sdk/python/dist/
/sdk/python/.venv/

# Generated .NET / NuGet build outputs
/packaging/nuget/dist/
/packaging/nuget/**/bin/
/packaging/nuget/**/obj/
/packaging/nuget/smbcloud-cli/native/

# smbCloud deploy config — carries workspace/app IDs; keep out of this public repo
/.smb/

# MCP Registry DNS/HTTP auth keypair — never commit the private half
/mcp-registry-key.pem
